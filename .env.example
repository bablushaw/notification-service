NODE_ENV=development
PORT=3005
API_PREFIX=api/v1
TCP_HOST=0.0.0.0
TCP_PORT=4005

# Shared with auth-service and request-service. Not a user JWT.
API_KEY=nearo_dev_notification_tcp_key_change_me

# Same Postgres as the other Nearo services. New tables only.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=admin
DB_NAME=nearo
DB_SYNC=true
DB_LOGGING=false

SEED_ON_BOOT=true

# Optional. Empty = read templates from Postgres only.
# docker compose maps notification Redis to host port 6380.
REDIS_HOST=
REDIS_PORT=6380

# Twilio is used only when NODE_ENV=production and all three are set.
# Development always logs SMS locally (no Twilio), including OTP 123456.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

CORS_ORIGINS=*
